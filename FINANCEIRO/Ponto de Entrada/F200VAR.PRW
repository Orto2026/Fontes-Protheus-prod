// ALTERADO TESTE GITHUB - DEMA AGORA
User Function F200VAR() 
Local aArea     := GetArea()
Local _cTitulo  := paramixb[1,1]
Local _cNosNum  := paramixb[1,4]
Local _cOcorre  := paramixb[1,14]


If AllTrim(_cOcorre) == "02"
    //Busca por IdCnab
    dbSelectArea("SE1")
    dbSetOrder(16) // Filial+IdCnab
    iF DBSeek(xFilial("SE1")+Substr(_cTitulo,1,10))

    	RecLock("SE1")
	    SE1->E1_OCORREN := "01"
    	If Empty(SE1->E1_NUMBCO)
	    	SE1->E1_NUMBCO  := _cNosNum
	    EndIf
	    MsUnLock()
    EndIf
EndIf

RestArea(aArea)

Return Nil
