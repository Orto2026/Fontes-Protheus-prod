User Function MT240TOK()
Local lRet := .T.
Local _aArea 	:= GetArea()
Local _aAreaB1 := SB1->(GetArea())

dbSelectArea("SB1")
dbSetOrder(1)
If dbSeek(xFilial("SB1")+M->D3_COD) .And. SB1->B1_TIPO $ "MS/MA/IF" .And. Empty(M->D3_XCHAPA)
	Aviso("Chapa Nao Informada","Para esse tipo de produto deve ser informado a Chapa do Funcionário",{"OK"},1)
	Return(.F.)
EndIf

RestArea(_aAreaB1)
RestArea(_aArea)

Return(lRet) 