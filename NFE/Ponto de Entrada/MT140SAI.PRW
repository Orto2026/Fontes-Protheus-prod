User Function MT140SAI

dbSelectArea("SZO")
dbSetOrder(2)
If dbSeek(xFilial("SZO")+PARAMIXB[2]+PARAMIXB[3])
	RecLock("SZO",.F.)
	SZO->ZO_JAEXP := "5"
	MsUnlock()
EndIf	

Return
