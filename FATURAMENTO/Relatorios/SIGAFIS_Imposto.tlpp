Return _nGet

/*/{Protheus.doc} SetSeguroItem
	(Metodo para setar o atributo nSeguroItem)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method SetSeguroItem(n_Set) Class SIGAFIS_Imposto

	Local _lAltera := .F.

	Default n_Set := Nil

	If ValType(n_Set) == "N" .And. Self:nPosicaoItem > 0 .And. Self:nPosicaoItem <= Len(Self:aItens)
		// Se já tiver seguro
		If !Empty(Self:aItens[Self:nPosicaoItem]:GetSeguroItem())
			// Considera como alteração
			_lAltera := .T.
		EndIf

		Self:aItens[Self:nPosicaoItem]:SetSeguroItem(n_Set)

		// Se for alteração
		If _lAltera
			// Altera as operações fiscais
			Self:AlteraOperacoesFiscais("IT_SEGURO",Self:aItens[Self:nPosicaoItem]:GetSeguroItem(),Self:nPosicaoItem)
		EndIf
	EndIf

Return Nil

