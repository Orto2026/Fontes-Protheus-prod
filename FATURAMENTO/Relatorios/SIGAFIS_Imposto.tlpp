/*/{Protheus.doc} SetCodigoProduto
	(Metodo para setar o atributo cCodigoProduto)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method SetCodigoProduto(c_Set) Class SIGAFIS_Imposto
	
	Local _lAltera := .F.

	Default c_Set := Nil

	If ValType(c_Set) == "C" .And. Self:nPosicaoItem > 0 .And. Self:nPosicaoItem <= Len(Self:aItens)
		// Se já tiver produto
		If !Empty(Self:aItens[Self:nPosicaoItem]:GetCodigoProduto())
			// Considera como alteração
			_lAltera := .T.
		EndIf

		Self:aItens[Self:nPosicaoItem]:SetCodigoProduto(c_Set)

		// Se for alteração
		If _lAltera
			// Altera as operações fiscais
			Self:AlteraOperacoesFiscais("IT_PRODUTO",Self:aItens[Self:nPosicaoItem]:GetCodigoProduto(),Self:nPosicaoItem)
		EndIf
	EndIf

Return Nil

/*/{Protheus.doc} GetCodigoProduto
	(Metodo para retornar o atributo cCodigoProduto)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021

	@return character, conteudo do atributo cCodigoProduto
	/*/
Method GetCodigoProduto() Class SIGAFIS_Imposto

	Local _cGet := ""

	If Self:nPosicaoItem > 0 .And. Self:nPosicaoItem <= Len(Self:aItens)
		_cGet := Self:aItens[Self:nPosicaoItem]:GetCodigoProduto()
	EndIf

Return _cGet

