/*/{Protheus.doc} New
	(Metodo construtor)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method New() Class SIGAFIS_Imposto

	Self:cCodigoCliFor := ""
	Self:cLojaCliFor := ""
	Self:cClienteFornecedor := ""
	Self:cTipoNotaFiscal := ""
	Self:cTipoCliFor := ""
	Self:cTipoComplemento1 := ""
	Self:cAliasProdutos := "SB1"
	Self:cRotina := ""
	Self:cTipoDocumento := ""
	Self:cEspecieDocumento := ""
	Self:cCodigoProspect := ""
	Self:cGrupoCliente := CriaVar("A1_GRPTRIB",.F.)
	Self:cRecolheISS := ""
	Self:cCodigoClienteEntrega := CriaVar("F3_CLIEFOR",.F.)
	Self:cLojaClienteEntrega := CriaVar("F3_LOJA",.F.)
	Self:cPedidoVenda := ""
	Self:cCodigoClienteFaturamento := ""
	Self:cLojaClienteFaturamento := ""
	Self:cTipoFrete := ""
	Self:cTipoComplemento2 := ""
	Self:cCodigoClienteDestino := ""
	Self:cLojaClienteDestino := ""

	Self:aRelacaoImpostos := {}
	Self:aTransportador := {}
	Self:aItens := {}

	Self:lImpostosRodape := .F.
	Self:lEmiteNotaFiscal := .T.
	Self:lCalculaIPI := .T.
	Self:lCalculaPCC := .F.
	Self:lCalculaINSS := .F.
	Self:lCalculaIRRF := .F.
	Self:lCalculaTributosGenericos := .F.

	Self:nTotalPedido := 0
	Self:nQtdeItens := 0
	Self:nPosicaoItem := 0

	Self:dDataEmissao := dDataBase

	// Inicializa as variaveis
	Self:VariaveisFiscais()

Return Nil

/*/{Protheus.doc} VariaveisFiscais
	(Metodo para inicializar as variaveis fiscais)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method VariaveisFiscais() Class SIGAFIS_Imposto

	// Atributos para conter os impostos ICMS
	Self:lIcms := .F.
	Self:nIcmsBase := 0
	Self:nIcmsAliquota := 0
	Self:nIcmsValor := 0

	// Atributos para conter os impostos IPI
	Self:lIpi := .F.
	Self:nIpiBase := 0
	Self:nIpiAliquota := 0
	Self:nIpiValor := 0

	// Atributos para conter os impostos PIS
	Self:lPis := .F.
	Self:nPisBase := 0
	Self:nPisAliquota := 0
	Self:nPisValor := 0

	// Atributos para conter os impostos COFINS
	Self:lCofins := .F.
	Self:nCofinsBase := 0
	Self:nCofinsAliquota := 0
	Self:nCofinsValor := 0

	// Atributos para conter os impostos ISS
	Self:lIss := .F.
	Self:nIssBase := 0
	Self:nIssAliquota := 0
	Self:nIssValor := 0

	// Atributos para conter os impostos IRRF
	Self:lIrrf := .F.
	Self:nIrrfBase := 0
	Self:nIrrfAliquota := 0
	Self:nIrrfValor := 0

	// Atributos para conter os impostos INSS
	Self:lInss := .F.
	Self:nInssBase := 0
	Self:nInssAliquota := 0
	Self:nInssValor := 0

	// Atributos para conter os impostos CSLL
	Self:lCsll := .F.
	Self:nCsllBase := 0
	Self:nCsllAliquota := 0
	Self:nCsllValor := 0

	// Atributos para conter os impostos PIS via apuração
	Self:lPisApuracao := .F.
	Self:nPisApuracaoBase := 0
	Self:nPisApuracaoAliquota := 0
	Self:nPisApuracaoValor := 0

	// Atributos para conter os impostos COFINS via apuração
	Self:lCofinsApuracao := .F.
	Self:nCofinsApuracaoBase := 0
	Self:nCofinsApuracaoAliquota := 0
	Self:nCofinsApuracaoValor := 0

	// Atributos para conter os impostos ICMS complementar
	Self:lIcmsComplementar := .F.
	Self:nIcmsComplementarBase := 0
	Self:nIcmsComplementarAliquota := 0
	Self:nIcmsComplementarValor := 0

	// Atributos para conter os impostos ICMS frete autonomo
	Self:lIcmsFreteAutonomo := .F.
	Self:nIcmsFreteAutonomoBase := 0
	Self:nIcmsFreteAutonomoAliquota := 0
	Self:nIcmsFreteAutonomoValor := 0

	// Atributos para conter os impostos ICMS frete autonomo ST
	Self:lIcmsFreteAutonomoST := .F.
	Self:nIcmsFreteAutonomoSTBase := 0
	Self:nIcmsFreteAutonomoSTAliquota := 0
	Self:nIcmsFreteAutonomoSTValor := 0

	// Atributos para conter os impostos ICMS ST
	Self:lIcmsST := .F.
	Self:nIcmsSTBase := 0
	Self:nIcmsSTAliquota := 0
	Self:nIcmsSTValor := 0

	// Atributos para conter os valores
	Self:nDesconto := 0
	Self:nFrete := 0
	Self:nSeguro := 0
	Self:nDespesa := 0
	Self:nValorMercadoria := 0

Return Self

/*/{Protheus.doc} InicializaOperacoesFiscais
	(Metodo para inicializar as operações fiscais)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method InicializaOperacoesFiscais() Class SIGAFIS_Imposto

	// Finaliza o uso das funcoes Fiscais
	MaFisEnd()

	// Se tiver o cliente fornecedor
	If !Empty(Self:cClienteFornecedor)
		// Se for o cliente
		If Self:cClienteFornecedor == "C"
			// Posiciona no cliente
			SA1->(DbSetOrder(1))	// A1_FILIAL+A1_COD+A1_LOJA
			SA1->(DbSeek(FWxFilial("SA1")+PadR(Self:cCodigoCliFor,TamSX3("A1_COD")[1])+PadR(Self:cLojaCliFor,TamSX3("A1_LOJA")[1])))
		EndIf

		// Se for o fornecedor
		If Self:cClienteFornecedor == "F"
			// Posiciona no fornecedor
			SA2->(DbSetOrder(1))	// A2_FILIAL+A2_COD+A2_LOJA
			SA2->(DbSeek(FWxFilial("SA2")+PadR(Self:cCodigoCliFor,TamSX3("A2_COD")[1])+PadR(Self:cLojaCliFor,TamSX3("A2_LOJA")[1])))
		EndIf
	EndIf

	// Inicializa o Calculo das operacoes Fiscais
	MaFisIni(;
		Self:cCodigoCliFor,;				// 01 Cod. Cli/For
		Self:cLojaCliFor,;					// 02 Lj do Cli/For
		Self:cClienteFornecedor,;			// 03 C:Cliente , F:Fornecedor
		Self:cTipoNotaFiscal,;				// 04 Tp NF( "N","D","B","C","P","I" )
		Self:cTipoCliFor,;					// 05 Tp do Cli/For
		Self:aRelacaoImpostos,;				// 06 Relacao de Impostos que suportados no arquivo
		Self:cTipoComplemento1,;			// 07 Tipo de complemento
		Self:lImpostosRodape,;				// 08 Permite Incluir Impostos no Rodape .T./.F.
		Self:cAliasProdutos,;				// 09 Alias do Cadastro de Produtos - ("SBI" P/ Front Loja)
		Self:cRotina,;						// 10 Nome da rotina que esta utilizando a funcao
		Self:cTipoDocumento,;				// 11 Tipo de documento
		Self:cEspecieDocumento,;			// 12 Especie do documento
		Self:cCodigoProspect,;				// 13 Codigo e Loja do Prospect
		Self:cGrupoCliente,;				// 14 Grupo Cliente
		Self:cRecolheISS,;					// 15 Recolhe ISS
		Self:cCodigoClienteEntrega,;		// 16 Codigo do cliente de entrega na nota fiscal de saida
		Self:cLojaClienteEntrega,;			// 17 Loja do cliente de entrega na nota fiscal de saida
		Self:aTransportador,;				// 18 Informacoes do transportador [01]-UF,[02]-TPTRANS
		Self:lEmiteNotaFiscal,;				// 19 Se esta emitindo nota fiscal ou cupom fiscal (Sigaloja)
		Self:lCalculaIPI,;					// 20 Define se calcula IPI (SIGALOJA)
		Self:cPedidoVenda,;					// 21 Pedido de Venda
		Self:cCodigoClienteFaturamento,;	// 22 Cliente do faturamento ( cCodCliFor é passado como o cliente de entrega, pois é o considerado na maioria das funções fiscais, exceto ao gravar o clinte nas tabelas do livro)
		Self:cLojaClienteFaturamento,;		// 23 Loja do cliente do faturamento
		Self:nTotalPedido,;					// 24 Total do Pedido
		Self:dDataEmissao,;					// 25 Data de emissão do documento inicialmente só é diferente de dDataBase nas notas de entrada (MATA103 e MATA910)
		Self:cTipoFrete,;					// 26 Tipo de Frete informado no pedido
		Self:lCalculaPCC,;					// 27 Indica se Calcula (PIS,COFINS,CSLL), independete da TES estar configurada para Gerar Duplicata (F4_DUPLIC)
		Self:lCalculaINSS,;					// 28 Indica se Calcula (INSS), independete da TES estar configurada para Gerar Duplicata (F4_DUPLIC)
		Self:lCalculaIRRF,;					// 29 Indica se Calcula (IRRF), independete da TES estar configurada para Gerar Duplicata (F4_DUPLIC)
		Self:cTipoComplemento2,;			// 30 Tipo de Complemento
		Self:cCodigoClienteDestino,;		// 31 Cliente de destino de transporte (Notas de entrada de transporte )
		Self:cLojaClienteDestino,;			// 32 Loja de destino de transporte (Notas de entrada de transporte )
		Self:lCalculaTributosGenericos,;	// 33 Flag para indicar se os tributos genéricos devem ou não ser calculados - deve ser passado como .T. somente após a preparação da rotina para gravação, visualização e exclusão dos tributos genéricos.
		Self:nQtdeItens)					// 34 Quantidade de itens no documento.

Return Nil

Method InicializaOperacoesFiscaisItem(l_Atualiza) Class SIGAFIS_Imposto

	Default l_Atualiza := .T.

	// Se tiver o cliente fornecedor
	If !Empty(Self:cAliasProdutos)
		// Se for o SB1
		If Self:cAliasProdutos == "SB1"
			// Posiciona no produto
			SB1->(DbSetOrder(1))	// B1_FILIAL+B1_COD
			If SB1->(DbSeek(FWxFilial("SB1")+PadR(Self:aItens[Self:nPosicaoItem]:GetCodigoProduto(),TamSX3("B1_COD")[1])))
				Self:aItens[Self:nPosicaoItem]:SetRecnoSB1(SB1->(Recno()))
			EndIf
		EndIf
	EndIf

	// Posiciona na TES
	SF4->(DbSetOrder(1))	// F4_FILIAL+F4_CODIGO
	If SF4->(DbSeek(FWxFilial("SF4")+PadR(Self:aItens[Self:nPosicaoItem]:GetTes(),TamSX3("F4_CODIGO")[1])))
		Self:aItens[Self:nPosicaoItem]:SetRecnoSF4(SF4->(Recno()))
	EndIf

	// Inicializa o Calculo das operacoes Fiscais por item
	MaFisAdd(;
		Self:aItens[Self:nPosicaoItem]:GetCodigoProduto(),;			// 01 Codigo do Produto ( Obrigatorio )
		Self:aItens[Self:nPosicaoItem]:GetTes(),;					// 02 Codigo do TES ( Opcional )
		Self:aItens[Self:nPosicaoItem]:GetQuantidade(),;			// 03 Quantidade ( Obrigatorio )
		Self:aItens[Self:nPosicaoItem]:GetPrecoUnitario(),;			// 04 Preco Unitario ( Obrigatorio )
		Self:aItens[Self:nPosicaoItem]:GetDescontoItem(),;			// 05 Valor do Desconto ( Opcional )
		Self:aItens[Self:nPosicaoItem]:GetNotaFiscalOriginal(),;	// 06 Numero da NF Original ( Devolucao/Benef )
		Self:aItens[Self:nPosicaoItem]:GetSerieOriginal(),;			// 07 Serie da NF Original ( Devolucao/Benef )
		Self:aItens[Self:nPosicaoItem]:GetRecnoOriginal(),;			// 08 RecNo da NF Original no arq SD1/SD2
		Self:aItens[Self:nPosicaoItem]:GetFreteItem(),;				// 09 Valor do Frete do Item ( Opcional )
		Self:aItens[Self:nPosicaoItem]:GetDespesaItem(),;			// 10 Valor da Despesa do item ( Opcional )
		Self:aItens[Self:nPosicaoItem]:GetSeguroItem(),;			// 11 Valor do Seguro do item ( Opcional )
		Self:aItens[Self:nPosicaoItem]:GetFreteAutonomo(),;			// 12 Valor do Frete Autonomo ( Opcional )
		Self:aItens[Self:nPosicaoItem]:GetValorMercadoriaItem(),;	// 13 Valor da Mercadoria ( Obrigatorio )
		Self:aItens[Self:nPosicaoItem]:GetValorEmbalagem(),;		// 14 Valor da Embalagem ( Opiconal )
		Self:aItens[Self:nPosicaoItem]:GetRecnoSB1(),;				// 15 RecNo do SB1
		Self:aItens[Self:nPosicaoItem]:GetRecnoSF4(),;				// 16 RecNo do SF4
		Self:aItens[Self:nPosicaoItem]:GetItem(),;					// 17 Item
		Self:aItens[Self:nPosicaoItem]:GetDespesaNaoTributadas(),;	// 18 Despesas nao tributadas - Portugal
		Self:aItens[Self:nPosicaoItem]:GetTara(),;					// 19 Tara - Portugal
		Self:aItens[Self:nPosicaoItem]:GetCfo(),;					// 20 CFO
		Self:aItens[Self:nPosicaoItem]:GetIndiceValorAdicional(),;	// 21 Array para o calculo do IVA Ajustado (opcional)
		Self:aItens[Self:nPosicaoItem]:GetConcepto(),;				// 22 Concepto
		Self:aItens[Self:nPosicaoItem]:GetBaseVeiculo(),;			// 23 Base Veiculo
		Self:aItens[Self:nPosicaoItem]:GetLoteProduto(),;			// 24 Lote Produto
		Self:aItens[Self:nPosicaoItem]:GetSubLoteProduto(),;		// 25 Sub-Lote Produto
		Self:aItens[Self:nPosicaoItem]:GetAbatimentoISS(),;			// 26 Valor do Abatimento ISS
		Self:aItens[Self:nPosicaoItem]:GetCodigoISS(),;				// 27 Codigo ISS
		Self:aItens[Self:nPosicaoItem]:GetClassificacaoFiscal(),;	// 28 Classificação Fiscal
		Self:aItens[Self:nPosicaoItem]:GetProdutoFiscal(),;			// 29 Cod. do Produto Fiscal
		Self:aItens[Self:nPosicaoItem]:GetRecnoProdutoFiscal(),;	// 30 Recno do Produto Fiscal
		Self:aItens[Self:nPosicaoItem]:GetNcmProdutoFiscal(),;		// 31 NCM do produto Fiscal
		Self:aItens[Self:nPosicaoItem]:GetIdTributosGenericos(),;	// 32 Id dos tributos genéricos para visualização/exclusão
		Self:aItens[Self:nPosicaoItem]:GetTipoOperacao())			// 33 Tipo de Operação (opcional)

	// Se atualiza
	If l_Atualiza
		// Atualiza operações fiscais
		Self:AtualizaOperacoesFiscais()
	EndIf

Return Nil

/*/{Protheus.doc} CalculaOperacoesFiscais
	(Metodo para calcular as operações fiscais)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method CalculaOperacoesFiscais() Class SIGAFIS_Imposto

	Local _nPosicao := 0
	Local _nCount := 0

	// Metodo para inicializar as operações fiscais
	Self:InicializaOperacoesFiscais()

	// Guarda a posição do item
	_nPosicao := Self:nPosicaoItem

	// Percorre todos os itens
	For _nCount := 1 To Len(Self:aItens)
		// Posiciona no item fiscal
		Self:GoItemFiscal(_nCount)

		// Metodo para inicializar as operações fiscais por item
		Self:InicializaOperacoesFiscaisItem(.F.)
	Next

	// Atualiza operações fiscais
	Self:AtualizaOperacoesFiscais()
	
	// Posiciona no item fiscal
	Self:GoItemFiscal(_nPosicao)

Return Nil

/*/{Protheus.doc} AlteraOperacoesFiscais
	(Metodo para alterar as operações fiscais)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method AlteraOperacoesFiscais(c_Campo,n_Valor,n_Item,l_NoCabec,n_ItemNao,l_Dupl,c_Rotina,l_Recal,d_VencReal,a_TrbGen) Class SIGAFIS_Imposto

	Default c_Campo := Nil
	Default c_Rotina := Nil
	
	Default n_Valor := Nil
	Default n_Item := Nil
	
	Default l_NoCabec := Nil
	Default n_ItemNao := Nil
	Default l_Dupl := Nil
	Default l_Recal := Nil
	
	Default d_VencReal := Nil
	
	Default a_TrbGen := Nil

	// Altera os valores de impostos e bases do item
	MaFisAlt(c_Campo,n_Valor,n_Item,l_NoCabec,n_ItemNao,l_Dupl,c_Rotina,l_Recal,d_VencReal,a_TrbGen)

	// Atualiza operações fiscais
	Self:AtualizaOperacoesFiscais()

Return Nil

/*/{Protheus.doc} RetornaImpostosCalculados
	(Metodo para retornar os impostos calculados)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method RetornaImpostosCalculados(n_Item,c_Campo,a_TrbGen) Class SIGAFIS_Imposto

	Local _cMaFisRet := ""

	Default n_Item := Nil

	Default c_Campo := Nil

	Default a_TrbGen := Nil

	// Retorna os impostos calculados pela MATXFIS
	_cMaFisRet := MaFisRet(n_Item,c_Campo,a_TrbGen)

Return _cMaFisRet

/*/{Protheus.doc} AtualizaOperacoesFiscais
	(Metodo para atualizar as operações fiscais)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method AtualizaOperacoesFiscais() Class SIGAFIS_Imposto

	Local _nCount := 0
	Local _nValor := 0

	// Metodo para inicializar as variaveis
	Self:VariaveisFiscais()

	// Percorre todos os itens
	For _nCount := 1 To Len(Self:aItens)
		// ICMS
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALICM")
		
		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIcmsItem(.T.)
			Self:aItens[_nCount]:SetIcmsBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEICM"))
			Self:aItens[_nCount]:SetIcmsAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQICM"))
			Self:aItens[_nCount]:SetIcmsValorItem(_nValor)

			// Soma ao valor total
			Self:lIcms := .T.
			Self:nIcmsBase += Self:aItens[_nCount]:GetIcmsBaseItem()
			Self:nIcmsAliquota := Self:aItens[_nCount]:GetIcmsAliquotaItem()
			Self:nIcmsValor += Self:aItens[_nCount]:GetIcmsValorItem()
		EndIf

		// IPI
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALIPI")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIpiItem(.T.)
			Self:aItens[_nCount]:SetIpiBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEIPI"))
			Self:aItens[_nCount]:SetIpiAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQIPI"))
			Self:aItens[_nCount]:SetIpiValorItem(_nValor)

			// Soma ao valor total
			Self:lIpi := .T.
			Self:nIpiBase += Self:aItens[_nCount]:GetIpiBaseItem()
			Self:nIpiAliquota := Self:aItens[_nCount]:GetIpiAliquotaItem()
			Self:nIpiValor += Self:aItens[_nCount]:GetIpiValorItem()
		EndIf

		// PIS
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALPIS")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetPisItem(.T.)
			Self:aItens[_nCount]:SetPisBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEPIS"))
			Self:aItens[_nCount]:SetPisAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQPIS"))
			Self:aItens[_nCount]:SetPisValorItem(_nValor)

			// Soma ao valor total
			Self:lPis := .T.
			Self:nPisBase += Self:aItens[_nCount]:GetPisBaseItem()
			Self:nPisAliquota := Self:aItens[_nCount]:GetPisAliquotaItem()
			Self:nPisValor += Self:aItens[_nCount]:GetPisValorItem()
		EndIf

		// COFINS
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALCOF")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetCofinsItem(.T.)
			Self:aItens[_nCount]:SetCofinsBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASECOF"))
			Self:aItens[_nCount]:SetCofinsAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQCOF"))
			Self:aItens[_nCount]:SetCofinsValorItem(_nValor)

			// Soma ao valor total
			Self:lCofins := .T.
			Self:nCofinsBase += Self:aItens[_nCount]:GetCofinsBaseItem()
			Self:nCofinsAliquota := Self:aItens[_nCount]:GetCofinsAliquotaItem()
			Self:nCofinsValor += Self:aItens[_nCount]:GetCofinsValorItem()
		EndIf

		// ISS
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALISS")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIssItem(.T.)
			Self:aItens[_nCount]:SetIssBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEISS"))
			Self:aItens[_nCount]:SetIssAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQISS"))
			Self:aItens[_nCount]:SetIssValorItem(_nValor)

			// Soma ao valor total
			Self:lIss := .T.
			Self:nIssBase += Self:aItens[_nCount]:GetIssBaseItem()
			Self:nIssAliquota := Self:aItens[_nCount]:GetIssAliquotaItem()
			Self:nIssValor += Self:aItens[_nCount]:GetIssValorItem()
		EndIf

		// IRRF
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALIRR")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIrrfItem(.T.)
			Self:aItens[_nCount]:SetIrrfBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEIRR"))
			Self:aItens[_nCount]:SetIrrfAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQIRR"))
			Self:aItens[_nCount]:SetIrrfValorItem(_nValor)

			// Soma ao valor total
			Self:lIrrf := .T.
			Self:nIrrfBase += Self:aItens[_nCount]:GetIrrfBaseItem()
			Self:nIrrfAliquota := Self:aItens[_nCount]:GetIrrfAliquotaItem()
			Self:nIrrfValor += Self:aItens[_nCount]:GetIrrfValorItem()
		EndIf

		// INSS
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALINS")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetInssItem(.T.)
			Self:aItens[_nCount]:SetInssBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEINS"))
			Self:aItens[_nCount]:SetInssAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQINS"))
			Self:aItens[_nCount]:SetInssValorItem(_nValor)

			// Soma ao valor total
			Self:lInss := .T.
			Self:nInssBase += Self:aItens[_nCount]:GetInssBaseItem()
			Self:nInssAliquota := Self:aItens[_nCount]:GetInssAliquotaItem()
			Self:nInssValor += Self:aItens[_nCount]:GetInssValorItem()
		EndIf

		// CSLL
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALCSL")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetCsllItem(.T.)
			Self:aItens[_nCount]:SetCsllBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASECSL"))
			Self:aItens[_nCount]:SetCsllAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQCSL"))
			Self:aItens[_nCount]:SetCsllValorItem(_nValor)

			// Soma ao valor total
			Self:lCsll := .T.
			Self:nCsllBase += Self:aItens[_nCount]:GetCsllBaseItem()
			Self:nCsllAliquota := Self:aItens[_nCount]:GetCsllAliquotaItem()
			Self:nCsllValor += Self:aItens[_nCount]:GetCsllValorItem()
		EndIf

		// PIS via apuração
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALPS2")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetPisApuracaoItem(.T.)
			Self:aItens[_nCount]:SetPisApuracaoBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEPS2"))
			Self:aItens[_nCount]:SetPisApuracaoAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQPS2"))
			Self:aItens[_nCount]:SetPisApuracaoValorItem(_nValor)

			// Soma ao valor total
			Self:lPisApuracao := .T.
			Self:nPisApuracaoBase += Self:aItens[_nCount]:GetPisApuracaoBaseItem()
			Self:nPisApuracaoAliquota := Self:aItens[_nCount]:GetPisApuracaoAliquotaItem()
			Self:nPisApuracaoValor += Self:aItens[_nCount]:GetPisApuracaoValorItem()
		EndIf

		// COFINS via apuração
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALCF2")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetCofinsApuracaoItem(.T.)
			Self:aItens[_nCount]:SetCofinsApuracaoBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASECF2"))
			Self:aItens[_nCount]:SetCofinsApuracaoAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQCF2"))
			Self:aItens[_nCount]:SetCofinsApuracaoValorItem(_nValor)

			// Soma ao valor total
			Self:lCofinsApuracao := .T.
			Self:nCofinsApuracaoBase += Self:aItens[_nCount]:GetCofinsApuracaoBaseItem()
			Self:nCofinsApuracaoAliquota := Self:aItens[_nCount]:GetCofinsApuracaoAliquotaItem()
			Self:nCofinsApuracaoValor += Self:aItens[_nCount]:GetCofinsApuracaoValorItem()
		EndIf

		// ICMS complementar
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALCMP")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIcmsComplementarItem(.T.)
			Self:aItens[_nCount]:SetIcmsComplementarBaseItem(0)
			Self:aItens[_nCount]:SetIcmsComplementarAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQCMP"))
			Self:aItens[_nCount]:SetIcmsComplementarValorItem(_nValor)

			// Soma ao valor total
			Self:lIcmsComplementar := .T.
			Self:nIcmsComplementarBase += Self:aItens[_nCount]:GetIcmsComplementarBaseItem()
			Self:nIcmsComplementarAliquota := Self:aItens[_nCount]:GetIcmsComplementarAliquotaItem()
			Self:nIcmsComplementarValor += Self:aItens[_nCount]:GetIcmsComplementarValorItem()
		EndIf

		// ICMS frete autonomo
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALICA")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIcmsFreteAutonomoItem(.T.)
			Self:aItens[_nCount]:SetIcmsFreteAutonomoBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASEICA"))
			Self:aItens[_nCount]:SetIcmsFreteAutonomoAliquotaItem(0)
			Self:aItens[_nCount]:SetIcmsFreteAutonomoValorItem(_nValor)

			// Soma ao valor total
			Self:lIcmsFreteAutonomo := .T.
			Self:nIcmsFreteAutonomoBase += Self:aItens[_nCount]:GetIcmsFreteAutonomoBaseItem()
			Self:nIcmsFreteAutonomoAliquota := Self:aItens[_nCount]:GetIcmsFreteAutonomoAliquotaItem()
			Self:nIcmsFreteAutonomoValor += Self:aItens[_nCount]:GetIcmsFreteAutonomoValorItem()
		EndIf

		// ICMS frete autonomo ST
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALTST")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIcmsFreteAutonomoSTItem(.T.)
			Self:aItens[_nCount]:SetIcmsFreteAutonomoSTBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASETST"))
			Self:aItens[_nCount]:SetIcmsFreteAutonomoSTAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQTST"))
			Self:aItens[_nCount]:SetIcmsFreteAutonomoSTValorItem(_nValor)

			// Soma ao valor total
			Self:lIcmsFreteAutonomoST := .T.
			Self:nIcmsFreteAutonomoSTBase += Self:aItens[_nCount]:GetIcmsFreteAutonomoSTBaseItem()
			Self:nIcmsFreteAutonomoSTAliquota := Self:aItens[_nCount]:GetIcmsFreteAutonomoSTAliquotaItem()
			Self:nIcmsFreteAutonomoSTValor += Self:aItens[_nCount]:GetIcmsFreteAutonomoSTValorItem()
		EndIf

		// ICMS ST
		_nValor := Self:RetornaImpostosCalculados(_nCount,"IT_VALSOL")

		// Se tiver valor
		If !Empty(_nValor)
			// Adiciona no item
			Self:aItens[_nCount]:SetIcmsSTItem(.T.)
			Self:aItens[_nCount]:SetIcmsSTBaseItem(Self:RetornaImpostosCalculados(_nCount,"IT_BASESOL"))
			Self:aItens[_nCount]:SetIcmsSTAliquotaItem(Self:RetornaImpostosCalculados(_nCount,"IT_ALIQSOL"))
			Self:aItens[_nCount]:SetIcmsSTValorItem(_nValor)

			// Soma ao valor total
			Self:lIcmsST := .T.
			Self:nIcmsSTBase += Self:aItens[_nCount]:GetIcmsSTBaseItem()
			Self:nIcmsSTAliquota := Self:aItens[_nCount]:GetIcmsSTAliquotaItem()
			Self:nIcmsSTValor += Self:aItens[_nCount]:GetIcmsSTValorItem()
		EndIf

		// Adiciona os valores nos itens
		Self:aItens[_nCount]:SetDescontoItem(Self:RetornaImpostosCalculados(_nCount,"IT_DESCONTO"))
		Self:aItens[_nCount]:SetFreteItem(Self:RetornaImpostosCalculados(_nCount,"IT_FRETE"))
		Self:aItens[_nCount]:SetSeguroItem(Self:RetornaImpostosCalculados(_nCount,"IT_SEGURO"))
		Self:aItens[_nCount]:SetDespesaItem(Self:RetornaImpostosCalculados(_nCount,"IT_DESPESA"))
		Self:aItens[_nCount]:SetValorMercadoriaItem(Self:RetornaImpostosCalculados(_nCount,"IT_VALMERC"))

		// Valores
		Self:nDesconto += Self:aItens[_nCount]:GetDescontoItem()
		Self:nFrete += Self:aItens[_nCount]:GetFreteItem()
		Self:nSeguro += Self:aItens[_nCount]:GetSeguroItem()
		Self:nDespesa += Self:aItens[_nCount]:GetDespesaItem()
		Self:nValorMercadoria += Self:aItens[_nCount]:GetValorMercadoriaItem()
	Next

Return Nil

/*/{Protheus.doc} AddItemFiscal
	(Metodo para adicionar o item fiscal)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method AddItemFiscal() Class SIGAFIS_Imposto

	// Se for nulo
	If ValType(Self:aItens) == "U"
		Self:aItens := {}
	EndIf

	// Adciona uma posição no itens
	Aadd(Self:aItens,SIGAFIS_ImpostoItens():New())

	// Guarda a posição do array
	Self:nPosicaoItem := Len(Self:aItens)

Return Self:nPosicaoItem

/*/{Protheus.doc} DelItemFiscal
	(Metodo para deletar o item fiscal)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method DelItemFiscal(n_Posicao) Class SIGAFIS_Imposto

	Local _lContinua := .F.

	Default n_Posicao := 0

	// Se a posição for maior que 0 e menor ou igual a quantidade de itens
	If n_Posicao > 0 .And. n_Posicao <= Len(Self:aItens)
		// Deleta a posição
		ADel(Self:aItens,n_Posicao)

		// Redimensiona o array do cabeçalho
		ASize(Self:aItens,Len(Self:aItens)-1)

		// Se a posição atual for maior que a quantidade de linhas
		If Self:nPosicaoItem > Len(Self:aItens)
			// A posição atual se torna a ultima linha
			Self:nPosicaoItem := Len(Self:aItens)
		EndIf

		// Seta que conseguiu deletar
		_lContinua := .T.
	EndIf

Return _lContinua

/*/{Protheus.doc} GoItemFiscal
	(Metodo para posicionar no item fiscal)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method GoItemFiscal(n_Posicao) Class SIGAFIS_Imposto

	Local _lContinua := .F.

	Default n_Posicao := 0

	// Se a posição for maior que 0 e menor ou igual a quantidade de itens
	If n_Posicao > 0 .And. n_Posicao <= Len(Self:aItens)
		// Posiciona no item
		Self:nPosicaoItem := n_Posicao

		// Seta que conseguiu posicionar
		_lContinua := .T.
	EndIf

Return _lContinua

/*/{Protheus.doc} GetItemFiscal
	(Metodo para retornar o item fiscal)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method GetItemFiscal() Class SIGAFIS_Imposto

	Local _aItem := {}

	// Se possui posição for maior que 0
	If Self:nPosicaoItem > 0
		// Retorna o item
		_aItem := AClone(Self:aItens[Self:nPosicaoItem])
	EndIf

Return _aItem

/*/{Protheus.doc} GetPosicaoItemFiscal
	(Metodo para retornar a posição do item fiscal)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021

	@return numerico, contém a posição do item
	/*/
Method GetPosicaoItemFiscal() Class SIGAFIS_Imposto
Return Self:nPosicaoItem

