	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method SetQuantidade(n_Set) Class SIGAFIS_Imposto

	Local _lAltera := .F.

	Default n_Set := Nil

	If ValType(n_Set) == "N" .And. Self:nPosicaoItem > 0 .And. Self:nPosicaoItem <= Len(Self:aItens)
		// Se já tiver quantidade
		If !Empty(Self:aItens[Self:nPosicaoItem]:GetQuantidade())
			// Considera como alteração
			_lAltera := .T.
		EndIf

		Self:aItens[Self:nPosicaoItem]:SetQuantidade(n_Set)

		// Se for alteração
		If _lAltera
			// Altera as operações fiscais
			Self:AlteraOperacoesFiscais("IT_QUANT",Self:aItens[Self:nPosicaoItem]:GetQuantidade(),Self:nPosicaoItem)
		EndIf
	EndIf

Return Nil

