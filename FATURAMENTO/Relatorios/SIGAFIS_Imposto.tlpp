/*/{Protheus.doc} SetDescontoItem
	(Metodo para setar o atributo nDescontoItem)

	@type Method
	@author Vitor Ribeiro - vitor.ribeiro@wikitec.com.br (Consultoria Wikitec)
	@since 26/04/2021
	/*/
Method SetDescontoItem(n_Set) Class SIGAFIS_Imposto

	Local _lAltera := .F.

	Default n_Set := Nil

	If ValType(n_Set) == "N" .And. Self:nPosicaoItem > 0 .And. Self:nPosicaoItem <= Len(Self:aItens)
		// Se já tiver desconto
		If !Empty(Self:aItens[Self:nPosicaoItem]:GetDescontoItem())
			// Considera como alteração
			_lAltera := .T.
		EndIf

		Self:aItens[Self:nPosicaoItem]:SetDescontoItem(n_Set)

		// Se for alteração
		If _lAltera
			// Altera as operações fiscais
			Self:AlteraOperacoesFiscais("IT_DESCONTO",Self:aItens[Self:nPosicaoItem]:GetDescontoItem(),Self:nPosicaoItem)
		EndIf
	EndIf

Return Nil

