±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±±
ßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßßß
*/

Static Function ValidPerg()
Local _sAlias	:= Alias()
Local aRegs		:= {}
Local i := 0
Local j := 0
Local nTamSX1	:= Len(SX1->X1_GRUPO)
dbSelectArea("SX1")
dbSetOrder(1)
cPerg 			:= PADR("AFRHR01",nTamSX1)

Aadd(aRegs,{cPerg,"01","Matricula De..........? ","Matricula De..........?","Matricula De..........?","mv_cha","C",06,0, 0,"G","","mv_par01","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
Aadd(aRegs,{cPerg,"02","Matricula Até.........? ","Matricula Até.........?","Matricula Até.........?","mv_chb","C",06,0, 0,"G","","mv_par02","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
Aadd(aRegs,{cPerg,"03","Periodo...............? ","Periodo...............?","Periodo...............?","mv_chc","D",08,0, 0,"G","","mv_par03","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
Aadd(aRegs,{cPerg,"04","Verba De..............? ","Verba De..............?","Verba De..............?","mv_chd","C",03,0, 0,"G","","mv_par04","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
Aadd(aRegs,{cPerg,"05","Verba Até.............? ","Verba Até.............?","Verba Até.............?","mv_che","C",03,0, 0,"G","","mv_par05","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
Aadd(aRegs,{cPerg,"06","C. Custo De...........? ","C. Custo De...........?","C. Custo De...........?","mv_chf","C",06,0, 0,"G","","mv_par06","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})
Aadd(aRegs,{cPerg,"07","C. Custo Até..........? ","C. Custo Até..........?","C. Custo Até..........?","mv_chg","C",06,0, 0,"G","","mv_par07","", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""})

For i:=1 to Len(aRegs)
	If !dbSeek(cPerg+aRegs[i,2])
		RecLock("SX1",.T.)
		For j:=1 to FCount()
			If j <= Len(aRegs[i])
				FieldPut(j,aRegs[i,j])
			Endif
		Next
		MsUnlock()            
	Endif
Next i

DbCloseArea(_sAlias)

Return()
